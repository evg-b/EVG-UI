{
  "name": "@evg-b/evg-ui",
  "version": "0.0.2",
  "description": "EVG-UI library inspired by Material Design.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "keywords": [
    "react",
    "react-component",
    "material design",
    "material",
    "evg-ui",
    "evg",
    "ui",
    "components library",
    "components"
  ],
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "dev": "node ./scripts/dev.mjs",
    "build:playground": "yarn build && vite build --config playground/vite.config.mjs",
    "preview": "vite preview --config playground/vite.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "icons:generate": "go run ./scripts/DownloadIcons.go",
    "docs:dev": "yarn build && docusaurus start docsite",
    "docs:build": "yarn build && docusaurus build docsite",
    "docs:preview": "docusaurus serve docsite",
    "docs:deploy": "yarn build && docusaurus deploy docsite",
    "docs:clear": "docusaurus clear docsite",
    "propdoc": "yarn propdoc:jsonAPI && yarn propdoc:APImdx && yarn propdoc:snippet",
    "propdoc:jsonAPI": "yarn node ./scripts/propdoc.js",
    "propdoc:APImdx": "yarn node ./scripts/propGenApi.js",
    "propdoc:snippet": "yarn node ./scripts/GenerationSnippets.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/evg-b/EVG-UI.git"
  },
  "author": "evg-b",
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "^7.12.5"
  },
  "peerDependencies": {
    "styled-components": "^6.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.12.10",
    "@babel/plugin-external-helpers": "^7.12.13",
    "@babel/plugin-proposal-class-properties": "^7.12.1",
    "@babel/plugin-proposal-object-rest-spread": "^7.12.1",
    "@babel/plugin-transform-runtime": "^7.12.10",
    "@babel/preset-env": "^7.12.11",
    "@babel/preset-react": "^7.12.10",
    "@docusaurus/core": "2.0.0-alpha.70",
    "@docusaurus/preset-classic": "2.0.0-alpha.70",
    "@mdx-js/react": "^1.6.21",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-eslint": "^10.1.0",
    "classnames": "^2.2.6",
    "eslint": "^7.16.0",
    "eslint-plugin-react": "^7.21.5",
    "eslint-plugin-react-hooks": "^4.2.0",
    "glob": "^7.1.4",
    "react": "19.3.1",
    "react-docgen": "^5.3.1",
    "react-dom": "19.3.1",
    "react-syntax-highlighter": "^15.4.3",
    "styled-components": "^6.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
