{
  "name": "@evg-b/evg-ui",
  "version": "0.0.2",
  "description": "EVG-UI library inspired by Material Design.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "keywords": [
    "react",
    "react-component",
    "material design",
    "material",
    "evg-ui",
    "evg",
    "ui",
    "components library",
    "components"
  ],
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "dev": "tsx ./scripts/dev.mts",
    "build:playground": "yarn build && vite build --config playground/vite.config.mts",
    "preview": "vite preview --config playground/vite.config.mts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "icons:generate": "go run ./scripts/DownloadIcons.go",
    "docs:dev": "yarn build && docusaurus start docsite",
    "docs:build": "yarn build && docusaurus build docsite",
    "docs:preview": "docusaurus serve docsite",
    "docs:clear": "docusaurus clear docsite",
    "propdoc": "yarn propdoc:jsonAPI && yarn propdoc:APImdx && yarn propdoc:snippet",
    "propdoc:jsonAPI": "tsx ./scripts/propdoc.mts",
    "propdoc:APImdx": "tsx ./scripts/propGenApi.mts",
    "propdoc:snippet": "tsx ./scripts/GenerationSnippets.mts",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build:storybook": "storybook build --output-dir storybook-static"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/evg-b/EVG-UI.git"
  },
  "author": "evg-b",
  "license": "MIT",
  "dependencies": {
    "styled-components": "6.6.0"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@docusaurus/babel": "3.10.2",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/js": "9.39.5",
    "@mdx-js/react": "3.1.1",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@types/node": "22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-loader": "9.2.1",
    "babel-plugin-styled-components": "2.1.4",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "react": "19.3.1",
    "react-docgen-typescript": "2.4.0",
    "react-dom": "19.3.1",
    "react-syntax-highlighter": "15.4.3",
    "storybook": "10.6.7",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.0.0",
    "webpack": "5.112.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  }
}
