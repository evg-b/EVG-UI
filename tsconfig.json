{
  "compilerOptions": {
    "target": "ES2015",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["react", "react-dom"],
    "paths": {
      "@evg-b/evg-ui": ["./packages/evg-ui/src/index.ts"],
      "@evg-b/evg-icons": ["./packages/evg-icons/src/index.ts"],
      "@evg-b/evg-tools": ["./packages/evg-tools/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*", "playground/src/**/*"],
  "exclude": ["node_modules", "**/dist"]
}
