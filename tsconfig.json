{
  "compilerOptions": {
    "target": "ES2015",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node",
      "react",
      "react-dom",
      "vite/client",
      "@docusaurus/module-type-aliases",
      "@docusaurus/theme-classic"
    ],
    "paths": {
      "@evg-b/evg-ui": [
        "./src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "docsite/**/*.ts",
    "docsite/**/*.tsx",
    "playground/**/*.ts",
    "playground/**/*.tsx",
    "playground/**/*.mts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "*.mts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    ".storybook/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/dist",
    "docsite/build",
    "docsite/.docusaurus",
    "storybook-static"
  ]
}
